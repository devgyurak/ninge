{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "./scripts/verify.sh*": "allow",
      "python3 scripts/*": "allow",
      "cargo fmt*": "allow",
      "cargo clippy*": "allow",
      "cargo check*": "allow",
      "cargo build*": "allow",
      "cargo test*": "allow",
      "cargo nextest*": "allow",
      "cargo tree*": "allow",
      "cargo doc*": "allow",
      "cargo llvm-cov*": "allow",
      "cargo deny*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "cargo add*": "ask",
      "cargo install*": "ask",
      "cargo update*": "ask",
      "cargo insta accept*": "ask",
      "gh issue create*": "ask",
      "gh pr create*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf*": "deny"
    }
  },
  "agent": {
    "build": {
      "description": "Default implementation agent.",
      "mode": "primary"
    }
  }
}
